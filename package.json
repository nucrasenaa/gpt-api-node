{
  "name": "gpt-bridge-node",
  "version": "0.1.0",
  "private": true,
  "description": "Node.js rewrite of the ChatGPT Web bridge without the Character Game app",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:console": "npm --prefix apps/bridge-console run build",
    "build:all": "npm run build && npm run build:console",
    "start": "node dist/index.js",
    "dev": "npm run build && node --watch dist/index.js",
    "test": "npm run build && node --test dist/tests/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "^5.8.3"
  }
}
